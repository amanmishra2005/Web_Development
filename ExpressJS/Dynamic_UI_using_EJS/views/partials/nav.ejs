<header class="bg-red-500 text-white p-4 shadow-md">
  <nav class="container mx-auto flex justify-between items-center">
    <ul class="flex space-x-4">
      <li>
        <a
          href="/"
          class="<%= currentPath === '/' ? 'bg-red-700 font-semibold' : 'hover:bg-red-400' %> rounded px-4 py-2 transition duration-300"
          <%= currentPath === '/' ? 'aria-current="page"' : '' %>
          >Home</a
        >
      </li>
      <li>
        <a
          href="/host/add-home"
          class="<%= currentPath.startsWith('/host/add-home') ? 'bg-red-700 font-semibold' : 'hover:bg-red-400' %> rounded px-4 py-2 transition duration-300"
          <%= currentPath.startsWith('/host/add-home') ? 'aria-current="page"' : '' %>
          >Add Home</a
        >
      </li>
    </ul>
  </nav>
</header>