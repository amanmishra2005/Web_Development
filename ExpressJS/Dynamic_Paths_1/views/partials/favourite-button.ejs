<form
  class="m-0"
  action="/favourites/<%= homeIndex %><%= isFavourite ? '/remove' : '' %>"
  method="POST">
  <input type="hidden" name="returnTo" value="<%= returnTo %>">
  <button
    class="inline-flex items-center justify-center rounded-md px-4 py-2 font-semibold <%= isFavourite ? 'bg-red-100 text-red-700' : 'bg-pink-100 text-red-700 hover:bg-pink-200' %>"
    type="submit"
    aria-label="<%= isFavourite ? 'Remove from favourites' : 'Add to favourites' %>">
    <span aria-hidden="true"><%= isFavourite ? '♥' : '♡' %></span>
    <%= isFavourite ? (typeof removeLabel !== 'undefined' && removeLabel ? removeLabel : 'Saved to favourites') : 'Add to favourites' %>
  </button>
</form>
