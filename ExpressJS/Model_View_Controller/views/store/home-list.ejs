<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        Explore available homes
      </h2>
      <div class="flex flex-wrap justify-center gap-6">
        <% registeredHomes.forEach((home, homeIndex) => { %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300 w-full max-w-sm">
            <img
              src="<%= home.photoUrl && /^https?:\/\//i.test(home.photoUrl) ? home.photoUrl : '/home-placeholder.svg' %>"
              alt="<%= home.houseName %>"
              class="w-full h-48 object-cover"
              onerror="this.onerror=null;this.src='/home-placeholder.svg';">
            <div class="p-4">
              <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= home.houseName %></h3>
              <p class="text-gray-600 mb-2"><i class="fas fa-map-marker-alt mr-2"></i><%= home.location %></p>
              <div class="flex justify-between items-center mb-2">
                <span class="text-lg font-bold text-red-500">Rs<%= home.price %> / night</span>
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-yellow-400 mr-1">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-gray-700"><%= home.rating %></span>
                </div>
              </div>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <a href="/reserve/<%= homeIndex %>" class="inline-flex items-center justify-center rounded-md bg-green-600 px-4 py-2 font-semibold text-white hover:bg-green-700">Book</a>
                <form class="m-0" action="/favourites/<%= homeIndex %>" method="POST">
                  <input type="hidden" name="returnTo" value="/homes">
                  <button
                    class="inline-flex items-center justify-center rounded-md px-4 py-2 font-semibold <%= favouriteIndexes.includes(homeIndex) ? 'bg-red-100 text-red-700' : 'bg-pink-100 text-red-700 hover:bg-pink-200' %>"
                    type="submit"
                    aria-label="<%= favouriteIndexes.includes(homeIndex) ? 'Already in favourites' : 'Add to favourites' %>">
                    <span aria-hidden="true"><%= favouriteIndexes.includes(homeIndex) ? '♥' : '♡' %></span>
                    <%= favouriteIndexes.includes(homeIndex) ? 'Saved to favourites' : 'Add to favourites' %>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
