<% if (isFavourite) { %>
  <form action="/favourites/delete/<%= home.id %>" method="POST">
    <button type="submit" class="bg-red-300 p-2 hover:bg-red-500">Remove from Favourites</button>
  </form>
<% } else { %>
  <form action="/favourites" method="POST">
    <input type="hidden" name="id" value="<%= home.id %>">
    <button type="submit" class="bg-green-300 p-2 hover:bg-green-500">Add to Favourites</button>
  </form>
<% } %>