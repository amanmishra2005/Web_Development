<%- include('partials/head') %>
</head>
<body class="min-h-screen bg-gray-50">
  <%- include('partials/nav') %>
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Discover your next stay
      </h1>
      <p class="mt-2 text-gray-600">Browse our registered homes and find a place to feel at home.</p>
    </div>

    <% if (registeredHomes.length === 0) { %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-white px-6 py-14 text-center">
        <h2 class="text-xl font-semibold text-gray-800">No homes listed yet</h2>
        <p class="mt-2 text-gray-600">Add your home to make it appear here.</p>
        <a
          href="/host/add-home"
          class="mt-6 inline-flex rounded-md bg-red-500 px-5 py-2.5 font-semibold text-white transition hover:bg-red-600"
        >
          Add a home
        </a>
      </div>
    <% } else { %>
      <ul class="grid items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% registeredHomes.forEach(home => { %>
          <% const rating = Number(home.ratings || 0); %>
          <% const price = Number(home.price || 0); %>
          <li class="flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">
            <img
              src="<%= home.imageUrl %>"
              alt="<%= home.homeName %>"
              class="h-52 w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h2 class="wrap-break-word text-xl font-bold text-gray-900"><%= home.homeName %></h2>
                  <p class="mt-1 text-sm text-gray-600"><%= home.location %></p>
                </div>
                <div
                  class="flex shrink-0 items-center gap-2"
                  role="img"
                  aria-label="Rating: <%= rating.toFixed(1) %> out of 5"
                >
                  <span class="flex text-amber-500" aria-hidden="true">
                    <% for (let star = 1; star <= 5; star++) { %>
                      <span class="relative inline-block leading-none text-gray-300">★
                        <% if (rating >= star) { %>
                          <span class="absolute inset-y-0 left-0 overflow-hidden text-amber-500">★</span>
                        <% } else if (rating >= star - 0.5) { %>
                          <span class="absolute inset-y-0 left-0 w-1/2 overflow-hidden text-amber-500">★</span>
                        <% } %>
                      </span>
                    <% } %>
                  </span>
                  <span class="text-sm font-medium text-gray-700"><%= rating.toFixed(1) %></span>
                </div>
              </div>

              <p class="mt-4 flex-1 leading-relaxed text-gray-700"><%= home.description %></p>

              <div class="mt-5 flex items-end justify-between gap-4 border-t border-gray-200 pt-4">
                <p class="text-gray-600">
                  <span class="text-xl font-bold text-gray-900">₹<%= price.toFixed(2) %></span>
                  <span class="text-sm"> / night</span>
                </p>
                <p class="text-right text-sm text-gray-600">Up to <%= home.maxGuests %> guests</p>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </main>
</body>
</html>