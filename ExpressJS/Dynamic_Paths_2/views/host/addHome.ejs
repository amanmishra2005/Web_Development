<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">Add Your Home</h1>
      <form action="/host/add-home" method="POST" class="max-w-md mx-auto">
        <label for="houseName" class="block mb-1 font-medium text-gray-700">Home name</label>
        <input
          id="houseName"
          type="text"
          name="houseName"
          placeholder="e.g. Mishra Sadan"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <label for="price" class="block mb-1 font-medium text-gray-700">Price per night (₹)</label>
        <input
          id="price"
          type="number"
          name="price"
          placeholder="1500"
          min="1"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <label for="location" class="block mb-1 font-medium text-gray-700">Location</label>
        <input
          id="location"
          type="text"
          name="location"
          placeholder="City or neighbourhood"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <label for="description" class="block mb-1 font-medium text-gray-700">Description</label>
        <textarea
          id="description"
          name="description"
          rows="4"
          placeholder="Tell guests about your home, amenities, and experience"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
        <label for="rating" class="block mb-1 font-medium text-gray-700">Rating (1 to 5)</label>
        <input
          id="rating"
          type="number"
          name="rating"
          placeholder="4.5"
          min="1"
          max="5"
          step="0.1"
          required
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <label for="photoUrl" class="block mb-1 font-medium text-gray-700">Photo URL (optional)</label>
        <input
          id="photoUrl"
          type="text"
          name="photoUrl"
          placeholder="https://example.com/photo.jpg"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <button type="submit" class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300">Add Home</button>
      </form>
    </main>
  </body>
</html>
