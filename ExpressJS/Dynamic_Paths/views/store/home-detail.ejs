<%- include('../partials/head') %>
  </head>
  <body>
      <%- include('../partials/nav') %>
      <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
          <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
              Details of <%= home.houseName %>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="rounded-lg overflow-hidden">
                  <img
                    src="<%= home.photoUrl || '/home-placeholder.svg' %>"
                    alt="<%= home.houseName %>"
                    class="w-full h-96 object-cover"
                    onerror="this.onerror=null;this.src='/home-placeholder.svg';">
              </div>

              <div class="space-y-6">
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Description</h3>
                      <p class="text-gray-600"><%= home.description %></p>
                  </div>

                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Location</h3>
                      <p class="text-gray-600"><%= home.location %></p>
                  </div>

                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Price</h3>
                      <p class="text-green-600 text-xl font-bold">Rs<%= home.price %> / night</p>
                  </div>

                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Rating</h3>
                      <div class="flex items-center">
                          <span class="text-yellow-400 text-xl">★</span>
                          <span class="ml-2 text-lg"><%= home.rating %> / 5</span>
                      </div>
                  </div>

                  <form action="<%= isFavourite ? `/favourites/${homeIndex}/remove` : `/favourites/${homeIndex}` %>" method="POST">
                      <input type="hidden" name="returnTo" value="/homes/<%= home.id %>">
                      <button
                          type="submit"
                          class="inline-flex items-center justify-center rounded-md px-4 py-2 font-semibold <%= isFavourite ? 'bg-red-100 text-red-700' : 'bg-pink-100 text-red-700 hover:bg-pink-200' %>">
                          <span aria-hidden="true"><%= isFavourite ? '♥' : '♡' %></span>
                          <%= isFavourite ? 'Saved to favourites' : 'Add to favourites' %>
                      </button>
                  </form>
              </div>
          </div>
      </main>
  </body>
</html>